<?xml version="1.0" encoding="UTF-8"?>
<!--
	Bot zone definitions.
	Each <zone> must match the name used in ZoneRegistry.registerDefaultZones().

	<gatekeeper>   — Teleporter NPC position. Bot walks here before teleporting to farm zone.
	<shop>         — Grocer/Merchant position. Bot walks here when buying supplies.
	<cityPath>     — Ordered waypoints bot follows when walking through the city.
	               The last point should be at or near the gatekeeper.
	               Used when distance to destination exceeds TELEPORT_THRESHOLD.
-->
